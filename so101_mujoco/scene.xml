<mujoco model="scene">
    <include file="so101_new_calib.xml" />

    <!-- More stable/accurate contact handling for grasping: implicitfast integrator
         damps stiff actuator+contact interactions, elliptic friction cones + higher
         impratio reduce the "object launches on grasp" issue common with pyramidal
         cones and rigid Euler integration. -->
    <option integrator="implicitfast" cone="elliptic" impratio="10" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
            reflectance="0.2" />
        <material name="bin_material" rgba="0.55 0.35 0.15 1" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- 4 cm cube to pick up. Softer solref/solimp + condim=4 (friction +
             torsion) avoid the explosive "pop" that stiff mesh-vs-box contacts
             can cause when the gripper closes on it. -->
        <body name="cube" pos="0.25 0.09 0.02">
            <freejoint name="cube_free" />
            <inertial pos="0 0 0" mass="0.025" diaginertia="6.7e-6 6.7e-6 6.7e-6" />
            <geom name="cube_geom" type="box" size="0.02 0.02 0.02" rgba="0.85 0.1 0.1 1"
                friction="1.5 0.02 0.0005" condim="4" solref="0.02 1" solimp="0.95 0.99 0.001" />
        </body>

        <!-- Open-top bin/box (bigger, static) to drop the cube into: 16x12 cm
             footprint, 5 cm tall walls, ~14.8x10.8 cm clear interior. -->
        <body name="bin" pos="0.30 -0.15 0">
            <geom name="bin_floor" type="box" size="0.08 0.06 0.004" pos="0 0 0.004"
                material="bin_material" />
            <geom name="bin_wall_px" type="box" size="0.006 0.06 0.025" pos="0.074 0 0.033"
                material="bin_material" />
            <geom name="bin_wall_nx" type="box" size="0.006 0.06 0.025" pos="-0.074 0 0.033"
                material="bin_material" />
            <geom name="bin_wall_py" type="box" size="0.08 0.006 0.025" pos="0 0.054 0.033"
                material="bin_material" />
            <geom name="bin_wall_ny" type="box" size="0.08 0.006 0.025" pos="0 -0.054 0.033"
                material="bin_material" />
        </body>
    </worldbody>
</mujoco>